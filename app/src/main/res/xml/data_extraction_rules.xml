<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="gastos.db" />
        <include domain="sharedpref" path="gastos_prefs.xml" />
        <exclude domain="sharedpref" path="google_drive_token.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gastos.db" />
        <include domain="sharedpref" path="gastos_prefs.xml" />
        <exclude domain="sharedpref" path="google_drive_token.xml" />
    </device-transfer>
</data-extraction-rules>